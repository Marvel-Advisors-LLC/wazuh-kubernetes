# Archives Kubernetes configuration files with sensitive data
/envs/eks/pv-nfs.yaml
/envs/eks/pvc-nfs.yaml
/envs/eks/wazuh-indexer-legacy.yaml
/wazuh/secrets/m365-cred-secret.yaml
/wazuh/secrets/wazuh-s3-creds.yaml


# Unencrypted secrets: ignore all YAML files
/wazuh/cron_job/secrets/*.yaml
/wazuh/wazuh_managers/wazuh_conf/syslog-ng-secrets/*.yaml
/wazuh/secrets/*.yaml

# But allow versioning the encrypted ones
!/wazuh/cron_job/secrets/*.enc.yaml
!/wazuh/wazuh_managers/wazuh_conf/syslog-ng-secrets/*.enc.yaml
!/wazuh/secrets/*.enc.yaml

# Wazuh configuration files with sensitive data
wazuh/wazuh_managers/wazuh_conf/master.conf
wazuh/wazuh_managers/wazuh_conf/worker.conf